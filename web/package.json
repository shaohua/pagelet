{
  "name": "@pagelet/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --external:@pagelet/shared --outfile=dist/server/main.js",
    "dev": "node dev.mjs",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@hono/node-server": "^2.0.12",
    "@pagelet/shared": "*",
    "hono": "^4.12.33"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.4"
  }
}
